{
  "name": "basurto",
  "main": "cloudflare/worker.mjs",
  "account_id": "a42daa5d5844f10ca43694aaba7ff82b",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OFFICE",
        "class_name": "BasurtoOffice"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BasurtoOffice"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "TRAINING_FILES",
      "bucket_name": "basurto"
    }
  ]
}
